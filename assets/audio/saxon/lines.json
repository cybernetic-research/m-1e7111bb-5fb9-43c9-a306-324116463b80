},
{
"kind": "alfred_wife",
"file": "alfred_wife-10-0.mp3",
"female": true,
"text": "You'll eat them hot quick enough, but you can't turn them when they're burning!",
"speaker": "p250"
},
{
"kind": "alfred",
"file": "alfred-11-0.mp3",
"female": false,
"text": "Forgive me, mother. My mind was on other things.",
"speaker": "p226"
},
{
"kind": "alfred_men",
"file": "alfred_men-12-0.mp3",
"female": false,
"text": "My lord king! The men of Somerset are ready. Say the word.",
"speaker": "p254"
},
{
"kind": "shore_watch",
"file": "shore_watch-13-0.mp3",
"female": false,
"text": "Ships! Ships, out past the point!",
"speaker": "p273"
},
{
"kind": "shore_watch",
"file": "shore_watch-14-0.mp3",
"female": false,
"text": "Danes, for the islands. Light the beacon! Send word along the shore!",
"speaker": "p254"
},
{
"kind": "shore_watch",
"file": "shore_watch-15-0.mp3",
"female": false,
"text": "They'll not land here. Not while we watch this shore.",
"speaker": "p259"
},
{
"kind": "shore_false",
"file": "shore_false-16-0.mp3",
"female": false,
"text": "Where? I see nothing out there but the gulls.",
